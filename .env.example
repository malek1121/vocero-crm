# ============================================================
# Vocero CRM — variables de entorno
# Copia este archivo a .env y rellena los valores.
# ============================================================

# URL pública de la instancia (con https en producción).
APP_BASE_URL=http://localhost:3000

# Conexión a Postgres. En la Ruta B (docker compose) se arma sola con
# POSTGRES_PASSWORD; en desarrollo local apunta a tu Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vocero

# Contraseña del Postgres del docker-compose (Ruta B).
# Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Secreto de sesión de Better Auth.
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Clave de cifrado en reposo (AES-256-GCM) para la sesión de WhatsApp.
# EXACTAMENTE 32 bytes en base64 (44 caracteres).
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=

# Dominio para Caddy (solo Ruta B, HTTPS automático).
DOMAIN=


# ------------------------------------------------------------
# IA (opcional): proveedor OpenAI-compatible.
# Por defecto: Cloudflare Workers AI. Sin token, el CRM funciona
# completo excepto el agente de IA y el Laboratorio.
# ------------------------------------------------------------

# Endpoint con tu Account ID de Cloudflare:
# https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai

# API token de Cloudflare con permiso "Workers AI"
# (dash.cloudflare.com -> My Profile -> API Tokens).
AI_API_TOKEN=

# Modelo: https://developers.cloudflare.com/workers-ai/models/
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Modelo más barato para el juez del Laboratorio (opcional).
AI_JUDGE_MODEL=

# Milisegundos que el agente espera para agrupar mensajes seguidos.
AGENT_COALESCE_MS=6000

# ------------------------------------------------------------
# La conexión de WhatsApp NO usa variables: se hace desde la app
# (Configuración -> WhatsApp) escaneando un código QR. La sesión
# queda cifrada en la base de datos.
# ------------------------------------------------------------
